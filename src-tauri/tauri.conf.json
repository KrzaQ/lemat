{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lemat",
  "version": "0.1.0",
  "identifier": "cc.krzaq.lemat",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lemat",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["toml"],
        "name": "Lemat project",
        "description": "A Lemat project: engine, host, folder and board",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["md"],
        "name": "Markdown board",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
